{
  "name": "markens-messenger",
  "version": "31.21.0",
  "description": "MARKENS Messenger v31.21.0 — Игровой мессенджер, сервер VORTEX и голосовые комнаты Opus HD (Rust + Wasm Core) для Windows 10/11 (x64)",
  "main": "main.js",
  "author": "markens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marksambor0-hue/markensmasanger.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node scripts/verify-build.js",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "dist:setup": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "publish:github": "electron-builder --win nsis portable --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.markens.messenger",
    "productName": "MARKENS",
    "copyright": "Copyright © 2026 markens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "database.rules.json",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "marksambor0-hue",
        "repo": "markensmasanger",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "MARKENS_Setup_${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MARKENS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "MARKENS_Portable_${version}.exe"
    }
  }
}
